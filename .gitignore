.*
build/
cmake-build-debug/
cmake-build-debug-visual-studio/
cmake-build-msbuild/

# ignore doc
**/~$*.docx
/python/offs/**
/python/objs/**

# 生成的模型输出
/outputs/

# Minecraft 原生素材（体积大，按 docs/texture-mapping.md 的步骤重建，位于 data/assets）
/texture

# AI 助手上下文（本地知识库，不随仓库分发）
/.ai/

# 素材与参考归档（体积大或不随仓库分发），但测试数据 regions / matlab / snbt 需入库
/data/*
!/data/regions/
!/data/regions/**
!/data/matlab/
!/data/matlab/**
!/data/snbt/
!/data/snbt/**
#
# We don't want to ignore the following even if they are dot-files
#
!.gitignore
!.clang-format
